<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema base com ActionBar (DarkActionBar). DayNight troca automaticamente
        para as cores de values-night quando o tema escuro está ativo.
    -->
    <style name="Base.Theme.Receitas" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorPrimaryVariant">@color/cor_primaria_escura</item>
        <item name="colorOnPrimary">@color/cor_sobre_primaria</item>
        <item name="colorSecondary">@color/cor_secundaria</item>
        <item name="colorSecondaryVariant">@color/cor_secundaria_escura</item>
        <item name="colorOnSecondary">@color/cor_sobre_secundaria</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.Receitas" parent="Base.Theme.Receitas" />

    <!-- Estilos reutilizados nos layouts -->
    <style name="TextoTituloSecao">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="TextoSecundario">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cor_texto_secundario</item>
    </style>

    <style name="CampoFormulario" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
