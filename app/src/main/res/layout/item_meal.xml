<?xml version="1.0" encoding="utf-8"?>
<!-- Item da grade de receitas da API: imagem + nome -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivMeal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_imagem_grade"
            android:background="@color/cor_fundo_imagem"
            android:contentDescription="@string/desc_imagem_receita"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_receita_placeholder" />

        <TextView
            android:id="@+id/tvNomeMeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:padding="8dp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
