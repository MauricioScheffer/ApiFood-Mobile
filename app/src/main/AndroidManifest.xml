<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessárias para consumir a API TheMealDB e o backend MySQL (PHP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ReceitasApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Receitas">

        <!-- Home (tela inicial) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Listagem das receitas salvas (SQLite ou MySQL) -->
        <activity
            android:name=".ui.ReceitaListActivity"
            android:label="@string/titulo_minhas_receitas"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Cadastro e edição (mesma tela, modo definido pelo Intent) -->
        <activity
            android:name=".ui.ReceitaFormActivity"
            android:label="@string/titulo_nova_receita"
            android:parentActivityName=".ui.ReceitaListActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhes de uma receita salva -->
        <activity
            android:name=".ui.ReceitaDetalheActivity"
            android:label="@string/titulo_detalhe"
            android:parentActivityName=".ui.ReceitaListActivity" />

        <!-- Busca na API pública TheMealDB -->
        <activity
            android:name=".ui.ExplorarActivity"
            android:label="@string/titulo_explorar"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhes de uma receita da API -->
        <activity
            android:name=".ui.MealDetalheActivity"
            android:label="@string/titulo_detalhe_api"
            android:parentActivityName=".ui.ExplorarActivity" />

        <!-- Preferências do usuário (SharedPreferences) -->
        <activity
            android:name=".ui.ConfiguracoesActivity"
            android:label="@string/titulo_configuracoes"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
